{
  "name": "boston-latin-dance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fetch-events": "python3 scripts/scrape_ics.py",
    "fetch-sensualeros": "python3 scripts/scrape_ics.py sensualeros-boston",
    "fetch-lister": "python3 scripts/scrape_lister.py",
    "fetch-eventbrite": "python3 scripts/scrape_eventbrite.py",
    "fetch-bobas": "python3 scripts/scrape_facebook.py bobas",
    "fetch-submissions": "python3 scripts/fetch_submissions.py",
    "merge-events": "python3 scripts/merge_events.py",
    "publish-events": "python3 -c \"import sys; sys.path.insert(0,'scripts'); from event_store import publish; print(publish())\"",
    "dedup-report": "python3 scripts/dedup_report.py",
    "review-dedup": "python3 scripts/review_dedup.py --json",
    "verify-events": "python3 scripts/verify_events.py",
    "fetch-all": "npm run fetch-events && npm run fetch-sensualeros && npm run fetch-lister && npm run fetch-eventbrite && npm run fetch-submissions && npm run merge-events"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.5.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.4"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
