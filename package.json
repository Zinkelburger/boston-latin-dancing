{
  "name": "boston-latin-dance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write app lib types tests",
    "format:check": "prettier --check app lib types tests",
    "fetch-all": "python3 scripts/run_pipeline.py",
    "fetch-scrape": "python3 scripts/run_pipeline.py --scrape-only",
    "fetch-one": "python3 scripts/run_pipeline.py --scrape-only --only",
    "ingest-publish": "python3 -c \"import sys; sys.path.insert(0,'scripts'); from event_store import ingest_scraped, publish; print(ingest_scraped()); print(publish())\"",
    "publish-events": "python3 -c \"import sys; sys.path.insert(0,'scripts'); from event_store import publish; print(publish())\"",
    "source-signal": "python3 scripts/source_signal.py",
    "dedup-report": "python3 scripts/dedup_report.py",
    "review-dedup": "python3 scripts/dedup_report.py --pending --json",
    "verify-events": "python3 scripts/verify_events.py",
    "check-links": "python3 scripts/check_links.py",
    "check-links-live": "python3 scripts/check_links.py --only-live --fail-on-broken",
    "link-meta": "python3 scripts/link_meta.py",
    "cross-check": "python3 scripts/cross_check.py",
    "cross-check-conflicts": "python3 scripts/cross_check.py --disagreements",
    "slug-registry": "python3 scripts/slug_registry.py",
    "check-site": "python3 scripts/check_internal_links.py",
    "build-all": "npm run publish-events && npm run build && npm run check-site"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.5.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.3.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
