{
  "name": "boston-latin-dance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fetch-events": "python3 scripts/scrape_ics.py",
    "fetch-sensualeros": "python3 scripts/scrape_ics.py sensualeros-boston",
    "fetch-lister": "python3 scripts/scrape_jsonld.py lister-events",
    "fetch-eventbrite": "python3 scripts/scrape_eventbrite.py",
    "fetch-fiesta": "python3 scripts/scrape_fiesta_dance.py",
    "fetch-bobas": "python3 scripts/scrape_facebook.py bobas",
    "fetch-sabor-latino": "python3 scripts/scrape_facebook.py sabor-latino",
    "fetch-lowell-sitp": "python3 scripts/scrape_facebook.py lowell-sitp",
    "fetch-submissions": "python3 scripts/fetch_submissions.py",
    "fetch-unabulla": "python3 scripts/scrape_ics.py unabulla-cuban-boston",
    "fetch-timba": "python3 scripts/scrape_ics.py timba-messengers",
    "fetch-lawn-on-d": "python3 scripts/scrape_jsonld.py mato-lawn-on-d",
    "ingest-publish": "python3 -c \"import sys; sys.path.insert(0,'scripts'); from event_store import ingest_scraped, publish; print(ingest_scraped()); print(publish())\"",
    "publish-events": "python3 -c \"import sys; sys.path.insert(0,'scripts'); from event_store import publish; print(publish())\"",
    "source-signal": "python3 scripts/source_signal.py",
    "dedup-report": "python3 scripts/dedup_report.py",
    "review-dedup": "python3 scripts/dedup_report.py --pending --json",
    "verify-events": "python3 scripts/verify_events.py",
    "fetch-eastboston": "python3 scripts/scrape_eastboston.py",
    "fetch-harvardsquare": "python3 scripts/scrape_jsonld.py harvardsquare",
    "fetch-nlf": "python3 scripts/scrape_jsonld.py nlf-events",
    "fetch-prfestival": "python3 scripts/scrape_jsonld.py pr-festival-ma",
    "fetch-all": "npm run fetch-events && npm run fetch-sensualeros && npm run fetch-unabulla && npm run fetch-timba && npm run fetch-lister && npm run fetch-eventbrite && npm run fetch-fiesta && npm run fetch-bobas && npm run fetch-sabor-latino && npm run fetch-lowell-sitp && npm run fetch-lawn-on-d && npm run fetch-eastboston && npm run fetch-harvardsquare && npm run fetch-nlf && npm run fetch-prfestival && npm run fetch-submissions && npm run ingest-publish",
    "build-all": "npm run publish-events && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.5.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.4"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
